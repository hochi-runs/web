# Choose ONE WordPress mode. Leave both URLs empty to use the original local content.
# Full CMS: install wordpress/hochi-runs-content-bridge.zip on a plugin-capable WordPress site.
WORDPRESS_CONTENT_URL=
# Example: https://your-cms.example/wp-json/hochi/v1/content

# Free WordPress.com artist demo: a public, artist-only WP v2 posts collection.
# Example: https://public-api.wordpress.com/wp/v2/sites/123456/posts?slug=amal&_embed=1
WORDPRESS_ARTISTS_URL=
# Existing routes controlled by that collection (comma separated); unpublishing hides them.
WORDPRESS_MANAGED_ARTIST_SLUGS=

# Local prototype only: the demo launcher sets this to 1 for its Next.js dev process.
# Leave empty for normal runs, builds, and hosted deployments. Production rejects 1.
# With 1, use only a literal HTTP localhost or 127.0.0.1 URL with an explicit port,
# ending in /wp-json/hochi/v1/content or /?rest_route=/hochi/v1/content.
# Example: http://127.0.0.1:9401/?rest_route=/hochi/v1/content
WORDPRESS_LOCAL_DEMO=

# Optional immediate cache refresh from the plugin. Use 32+ random characters.
# Set the same value in WordPress > Hochi Runs > Connection and your hosting environment.
WORDPRESS_REVALIDATE_SECRET=

# Contact form delivery. All three settings are private server values.
# Use a Resend API key and a sender email on a verified sending domain.
# The recipient can be the label's existing Gmail inbox. Leave blank until configured.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Opt in to the custom radio player on a hosted deployment. Public previews only.
# Comma-separated exact HTTPS origins; leave empty to use the native Bandcamp embed.
RADIO_BANDCAMP_PREVIEW_ORIGINS=
# Example: https://hochiruns.com,https://www.hochiruns.com
